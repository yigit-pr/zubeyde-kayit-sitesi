---
import "../styles/global.css";
---

<!doctype html>
<html lang="tr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>
            Kurs Kayıt Formu | Zübeyde Hanım Eğitim Kurumları
        </title>
        <meta
            name="description"
            content="Zübeyde Hanım Eğitim Kurumları Robotik Kodlama, Piyano ve Tenis dersleri 2026 Yaz Dönemi Kayıtları başlamıştır. Kayıt formunu doldurarak hemen başvurun."
        />

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@700;800&display=swap"
            rel="stylesheet"
        />

        <style>
            :root {
                font-family: "Inter", sans-serif;
            }
            h1,
            h2,
            h3,
            .font-display {
                font-family: "Outfit", sans-serif;
            }
            .bg-dots {
                background-image: radial-gradient(
                    #1e3a8a 0.5px,
                    transparent 0.5px
                );
                background-size: 24px 24px;
                opacity: 0.05;
            }
        </style>
    </head>
    <body class="bg-slate-50 overflow-x-hidden">
        <!-- 1. Header (Minimalist + Socials) -->
        <header
            class="py-4 md:py-6 bg-white border-b border-slate-100 sticky top-0 z-50"
        >
            <div
                class="max-w-7xl mx-auto px-2 md:px-4 flex justify-between items-center"
            >
                <a href="/" class="flex items-center shrink-0">
                    <img
                        src="/images/logo.png"
                        alt="Zübeyde Hanım Eğitim Kurumları Logo"
                        class="h-10 md:h-16 w-auto"
                    />
                </a>

                <div class="flex items-center gap-2 md:gap-6">
                    <!-- Contact Info -->
                    <div
                        class="flex flex-col md:flex-row items-end md:items-center gap-1 md:gap-4 text-[10px] md:text-sm font-semibold text-slate-600"
                    >
                        <a
                            href="tel:02323321881"
                            class="flex items-center gap-1.5 hover:text-blue-900 transition-colors"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="w-3 h-3 md:w-4 md:h-4 text-amber-500"
                                ><path
                                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                                ></path></svg
                            >
                            0 232 332 1881
                        </a>
                        <a
                            href="mailto:info@zubeydehanim.com.tr"
                            class="flex items-center gap-1.5 hover:text-blue-900 transition-colors"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="w-3 h-3 md:w-4 md:h-4 text-amber-500"
                                ><rect width="20" height="16" x="2" y="4" rx="2"
                                ></rect><path
                                    d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
                                ></path></svg
                            >
                            info@zubeydehanim.com.tr
                        </a>
                    </div>

                    <!-- Socials -->
                    <div class="flex items-center gap-2 md:gap-4">
                        <a
                            href="https://www.instagram.com/zubeydehanimegitimkurumlari/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-blue-900 hover:text-amber-500 transition-colors bg-slate-50 p-1.5 md:p-2 rounded-full hover:bg-amber-50"
                            aria-label="Instagram"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="lucide lucide-instagram w-4 h-4 md:w-5 md:h-5"
                                ><rect
                                    width="20"
                                    height="20"
                                    x="2"
                                    y="2"
                                    rx="5"
                                    ry="5"></rect><path
                                    d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                                ></path><line
                                    x1="17.5"
                                    x2="17.51"
                                    y1="6.5"
                                    y2="6.5"></line></svg
                            >
                        </a>
                        <a
                            href="https://www.facebook.com/zubeydehanimegitimkurumlari"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-blue-900 hover:text-amber-500 transition-colors bg-slate-50 p-1.5 md:p-2 rounded-full hover:bg-amber-50"
                            aria-label="Facebook"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="lucide lucide-facebook w-4 h-4 md:w-5 md:h-5"
                                ><path
                                    d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
                                ></path></svg
                            >
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <main>
            <!-- 2. The Hero Section (Split Layout) -->
            <section
                class="relative overflow-hidden pt-12 pb-24 lg:pt-20 lg:pb-32 bg-white"
            >
                <div class="absolute inset-0 bg-dots"></div>
                <div
                    class="absolute inset-0 bg-gradient-to-b from-blue-50/50 to-transparent"
                >
                </div>

                <div class="max-w-7xl mx-auto px-4 relative z-10">
                    <div
                        class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center"
                    >
                        <!-- Left Column: The Pitch -->
                        <div class="relative z-10">
                            <span
                                class="inline-block px-4 py-1.5 bg-amber-100 text-amber-700 text-sm font-bold uppercase tracking-widest rounded-full mb-6"
                            >
                                2026 Yaz Dönemi Kayıtları
                            </span>
                            <h1
                                class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-blue-900 leading-[1.2] mb-6 tracking-tight"
                            >
                                Robotik Kodlama, Piyano ve <br />
                                Tenis Derslerine <br />
                                <span class="text-amber-500"
                                    >Kayıt Başladı!</span
                                >
                            </h1>
                            <p
                                class="text-lg text-slate-600 mb-8 max-w-xl leading-relaxed"
                            >
                                Zübeyde Hanım Eğitim Kurumları olarak çocuklarınızın yeteneklerini keşfetmeleri ve geliştirmeleri için Robotik Kodlama, Piyano ve Tenis derslerimizle yeni dönem kayıtlarımız başlamıştır. Kayıt formunu doldurarak yerinizi ayırtabilirsiniz.
                            </p>

                            <div class="relative max-w-lg mx-auto lg:mx-0 w-full aspect-[4/3] rounded-[2.5rem] shadow-2xl border-4 border-white overflow-hidden group">
                                <img
                                    src="/images/hero-child.png"
                                    alt="Robotik Kodlama, Piyano ve Tenis Eğitimi"
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-blue-900/40 to-transparent"></div>
                                
                                <!-- Floating Badges for Courses -->
                                <div class="absolute bottom-4 left-4 right-4 flex justify-between gap-2">
                                    <span class="px-3 py-1.5 bg-white/95 backdrop-blur-md text-blue-900 text-xs font-bold rounded-full shadow-md flex items-center gap-1.5">
                                        🤖 Kodlama
                                    </span>
                                    <span class="px-3 py-1.5 bg-white/95 backdrop-blur-md text-blue-900 text-xs font-bold rounded-full shadow-md flex items-center gap-1.5">
                                        🎹 Piyano
                                    </span>
                                    <span class="px-3 py-1.5 bg-white/95 backdrop-blur-md text-blue-900 text-xs font-bold rounded-full shadow-md flex items-center gap-1.5">
                                        🎾 Tenis
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: Registration Form -->
                        <div id="registration-form">
                            <div
                                class="bg-white p-8 md:p-10 rounded-[2.5rem] shadow-2xl shadow-blue-900/10 border-t-4 border-blue-900 relative"
                            >
                                <div class="mb-8">
                                    <h2
                                        class="text-2xl font-bold text-blue-900 mb-2"
                                    >
                                        Hemen Kayıt Oluşturun
                                    </h2>
                                    <p class="text-slate-500">
                                        Birkaç adımda kaydınızı tamamlayın.
                                    </p>
                                </div>

                                <form
                                    id="registration-form-element"
                                    class="space-y-4"
                                >
                                    <div>
                                        <label
                                            class="block text-sm font-semibold text-slate-700 mb-1.5 ml-1"
                                            >Ad Soyad</label
                                        >
                                        <input
                                            type="text"
                                            name="name"
                                            placeholder="Adınız ve soyadınız"
                                            class="input-field"
                                            required
                                        />
                                    </div>

                                    <div>
                                        <label
                                            class="block text-sm font-semibold text-slate-700 mb-1.5 ml-1"
                                            >Telefon Numarası</label
                                        >
                                        <input
                                            type="tel"
                                            name="phone"
                                            placeholder="05XX XXX XX XX"
                                            class="input-field"
                                            required
                                        />
                                    </div>

                                    <div>
                                        <label
                                            class="block text-sm font-semibold text-slate-700 mb-1.5 ml-1"
                                            >Öğrenci Adı</label
                                        >
                                        <input
                                            type="text"
                                            name="student_name"
                                            placeholder="Öğrencinin adı ve soyadı"
                                            class="input-field"
                                            required
                                        />
                                    </div>

                                    <div>
                                        <label
                                            class="block text-sm font-semibold text-slate-700 mb-1.5 ml-1"
                                            >Öğrenci Yaşı</label
                                        >
                                        <input
                                            type="number"
                                            name="student_age"
                                            placeholder="Öğrencinin yaşı"
                                            class="input-field"
                                            required
                                        />
                                    </div>

                                    <div>
                                        <label
                                            class="block text-sm font-semibold text-slate-700 mb-1.5 ml-1"
                                            >İlgilenilen Kurs</label
                                        >
                                        <select
                                            name="course"
                                            class="input-field bg-white"
                                            required
                                        >
                                            <option value="" disabled selected>Seçiniz...</option>
                                            <option value="Robotik Kodlama">Robotik Kodlama</option>
                                            <option value="Piyano">Piyano</option>
                                            <option value="Tenis">Tenis</option>
                                            <option value="Birden Fazla Kurs">Birden Fazla Kurs</option>
                                        </select>
                                    </div>

                                    <button
                                        type="submit"
                                        id="submit-button"
                                        class="btn-primary w-full mt-2"
                                    >
                                        Kayıt Ol
                                    </button>

                                    <p
                                        id="form-status"
                                        class="text-center text-xs mt-4 hidden"
                                    >
                                    </p>

                                    <p
                                        class="text-center text-[10px] text-slate-400 mt-4 leading-tight"
                                    >
                                        Kayıt formunu dolduran velilere kurs detayları ve başlangıç tarihleri iletişim bilgileri aracılığıyla iletilecektir.
                                    </p>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 3. Quick Info Strip -->
            <div class="max-w-5xl mx-auto px-4 -mt-10 relative z-20">
                <div
                    class="bg-white rounded-3xl shadow-xl border border-slate-100 p-8 grid grid-cols-1 md:grid-cols-3 gap-6 text-center divide-y md:divide-y-0 md:divide-x divide-slate-100"
                >
                    <div class="px-2 flex flex-col items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-500 mx-auto mb-3 w-8 h-8">
                            <path d="M12 8V4H8"></path>
                            <rect width="16" height="12" x="4" y="8" rx="2"></rect>
                            <path d="M9 12h.01"></path>
                            <path d="M15 12h.01"></path>
                            <path d="M19 16h2"></path>
                            <path d="M3 16h2"></path>
                            <path d="M8 16h8"></path>
                            <path d="M12 2v2"></path>
                        </svg>
                        <p
                            class="text-[10px] text-slate-500 uppercase font-bold tracking-wider mb-1"
                        >
                            KURS
                        </p>
                        <p class="font-bold text-blue-900 text-base">
                            Robotik Kodlama
                        </p>
                    </div>
                    <div class="px-2 pt-6 md:pt-0 flex flex-col items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-500 mx-auto mb-3 w-8 h-8">
                            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                            <path d="M6 4v16"></path>
                            <path d="M10 4v16"></path>
                            <path d="M14 4v16"></path>
                            <path d="M18 4v16"></path>
                            <path d="M8 4v10h1.5V4z" fill="currentColor"></path>
                            <path d="M12 4v10h1.5V4z" fill="currentColor"></path>
                            <path d="M16 4v10h1.5V4z" fill="currentColor"></path>
                        </svg>
                        <p
                            class="text-[10px] text-slate-500 uppercase font-bold tracking-wider mb-1"
                        >
                            KURS
                        </p>
                        <p class="font-bold text-blue-900 text-base">
                            Piyano
                        </p>
                    </div>
                    <div class="px-2 pt-6 md:pt-0 flex flex-col items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-500 mx-auto mb-3 w-8 h-8">
                            <ellipse cx="14.5" cy="9.5" rx="5.5" ry="5.5" transform="rotate(-45 14.5 9.5)"></ellipse>
                            <line x1="10.5" y1="13.5" x2="4.5" y2="19.5"></line>
                            <line x1="3.5" y1="20.5" x2="5.5" y2="18.5" stroke-width="3"></line>
                            <circle cx="6" cy="8" r="2" fill="currentColor" class="text-blue-900"></circle>
                        </svg>
                        <p
                            class="text-[10px] text-slate-500 uppercase font-bold tracking-wider mb-1"
                        >
                            KURS
                        </p>
                        <p class="font-bold text-blue-900 text-base">
                            Tenis
                        </p>
                    </div>
                </div>
            </div>

            <!-- 4. Info Section: "Bu Sınav Neden Önemli?" -->
            <section class="py-24 bg-slate-50 relative overflow-hidden">
                <div class="max-w-7xl mx-auto px-4 relative z-10">
                    <div class="text-center mb-16">
                        <h2
                            class="text-3xl md:text-5xl font-extrabold text-blue-900 mb-4"
                        >
                            Kurslarımız Hakkında
                        </h2>
                        <div class="w-24 h-2 bg-amber-500 mx-auto rounded-full">
                        </div>
                    </div>

                    <div class="space-y-16">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                            <!-- Course Card 1: Robotik Kodlama -->
                            <div class="bg-white rounded-[2.5rem] shadow-xl shadow-blue-900/5 border border-slate-100 overflow-hidden flex flex-col hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 group">
                                <div class="aspect-[4/3] w-full relative overflow-hidden">
                                    <img src="/images/kutucuk 1.jpg" alt="Robotik Kodlama" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                                    <div class="absolute top-4 left-4 bg-amber-500 text-white w-10 h-10 rounded-full flex items-center justify-center text-lg font-bold shadow-md">🤖</div>
                                </div>
                                <div class="p-6 md:p-8 flex flex-col flex-grow">
                                    <h3 class="text-xl md:text-2xl font-bold text-blue-900 mb-3">Robotik Kodlama</h3>
                                    <p class="text-slate-600 leading-relaxed text-sm md:text-base flex-grow">
                                        Öğrencilerimiz robotik kodlama derslerinde algoritma geliştirme, problem çözme ve yaratıcı düşünme becerilerini eğlenceli projelerle kazanır. Teknolojinin temellerini küçük yaşta öğrenmek için ideal bir program.
                                    </p>
                                </div>
                            </div>
                            
                            <!-- Course Card 2: Piyano -->
                            <div class="bg-white rounded-[2.5rem] shadow-xl shadow-blue-900/5 border border-slate-100 overflow-hidden flex flex-col hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 group">
                                <div class="aspect-[4/3] w-full relative overflow-hidden">
                                    <img src="/images/kutucuk 2.jpg" alt="Piyano" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                                    <div class="absolute top-4 left-4 bg-blue-900 text-white w-10 h-10 rounded-full flex items-center justify-center text-lg font-bold shadow-md">🎹</div>
                                </div>
                                <div class="p-6 md:p-8 flex flex-col flex-grow">
                                    <h3 class="text-xl md:text-2xl font-bold text-blue-900 mb-3">Piyano</h3>
                                    <p class="text-slate-600 leading-relaxed text-sm md:text-base flex-grow">
                                        Müziğin evrensel diliyle buluşan öğrencilerimiz, piyano derslerinde nota okuma, ritim ve müzikal ifade yeteneklerini geliştirir. Başlangıç seviyesinden ileri seviyeye kadar her öğrenciye uygun program.
                                    </p>
                                </div>
                            </div>

                            <!-- Course Card 3: Tenis -->
                            <div class="bg-white rounded-[2.5rem] shadow-xl shadow-blue-900/5 border border-slate-100 overflow-hidden flex flex-col hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 group">
                                <div class="aspect-[4/3] w-full relative overflow-hidden">
                                    <img src="/images/kutucuk 3.jpg" alt="Tenis" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                                    <div class="absolute top-4 left-4 bg-amber-500 text-white w-10 h-10 rounded-full flex items-center justify-center text-lg font-bold shadow-md">🎾</div>
                                </div>
                                <div class="p-6 md:p-8 flex flex-col flex-grow">
                                    <h3 class="text-xl md:text-2xl font-bold text-blue-900 mb-3">Tenis</h3>
                                    <p class="text-slate-600 leading-relaxed text-sm md:text-base flex-grow">
                                        Tenis derslerimizde öğrenciler temel vuruş tekniklerini, oyun kurallarını ve sportif disiplini deneyimli antrenörler eşliğinde öğrenir. Çiçekliköy Kampüsü'nün açık kortlarında uygulamalı eğitim.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div
                            class="grid md:grid-cols-12 gap-10 items-stretch bg-white p-6 md:p-10 rounded-[2.5rem] shadow-2xl shadow-blue-900/5 border border-slate-100 overflow-hidden"
                        >
                            <div
                                class="md:col-span-7 md:order-1 order-2 flex flex-col justify-center py-4 pl-4 text-slate-700"
                            >
                                <h3
                                    class="text-3xl font-bold text-blue-900 mb-6"
                                >
                                    Kurslarımızda Neler Kazanacaksınız?
                                </h3>
                                <p class="text-lg leading-relaxed text-slate-600 mb-2">
                                    Kurslarımız süresince öğrencilerimizin kazanacağı temel yetkinlikler:
                                </p>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-sm font-semibold text-blue-900 mt-4">
                                    <ul class="space-y-3">
                                        <li class="flex items-center gap-2 pb-2 border-b border-slate-50">
                                            <span class="text-amber-500 font-bold">✦</span> Robotik Kodlama: Algoritma ve Problem Çözme
                                        </li>
                                        <li class="flex items-center gap-2 pb-2 border-b border-slate-50">
                                            <span class="text-amber-500 font-bold">✦</span> Robotik Kodlama: Proje Tabanlı Öğrenme
                                        </li>
                                        <li class="flex items-center gap-2 pb-2 border-b border-slate-50">
                                            <span class="text-amber-500 font-bold">✦</span> Robotik Kodlama: Takım Çalışması
                                        </li>
                                        <li class="flex items-center gap-2 pb-2 border-b border-slate-50">
                                            <span class="text-amber-500 font-bold">✦</span> Piyano: Nota Okuma ve Teori
                                        </li>
                                        <li class="flex items-center gap-2 pb-2 border-b border-slate-50">
                                            <span class="text-amber-500 font-bold">✦</span> Piyano: Müzikal İfade ve Ritim
                                        </li>
                                        <li class="flex items-center gap-2 pb-2 border-b border-slate-50">
                                            <span class="text-amber-500 font-bold">✦</span> Piyano: Sahne Performansı
                                        </li>
                                    </ul>
                                    <ul class="space-y-3">
                                        <li class="flex items-center gap-2 pb-2 border-b border-slate-50">
                                            <span class="text-amber-500 font-bold">✦</span> Tenis: Temel Vuruş Teknikleri
                                        </li>
                                        <li class="flex items-center gap-2 pb-2 border-b border-slate-50">
                                            <span class="text-amber-500 font-bold">✦</span> Tenis: Oyun Kuralları ve Taktik
                                        </li>
                                        <li class="flex items-center gap-2 pb-2 border-b border-slate-50">
                                            <span class="text-amber-500 font-bold">✦</span> Tenis: Sportif Disiplin ve Özgüven
                                        </li>
                                        <li class="flex items-center gap-2 pb-2 border-b border-slate-50">
                                            <span class="text-amber-500 font-bold">✦</span> Tüm Kurslar: Sertifika
                                        </li>
                                        <li class="flex items-center gap-2 pb-2 border-b border-slate-50">
